# Discord bot token (Developer Portal -> your application -> Bot -> Token)
DISCORD_BOT_TOKEN=

# Fluxer bot token (created in the Fluxer dashboard for your application)
FLUXER_BOT_TOKEN=

# Fluxer instance origin. Use your own origin for a self-hosted instance.
FLUXER_ORIGIN=https://fluxer.app

# Path to the SQLite database file
DB_PATH=./data/fluxify.db
